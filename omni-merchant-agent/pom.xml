<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.omnimerchant</groupId>
        <artifactId>omni-merchant</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>omni-merchant-agent</artifactId>

    <packaging>jar</packaging>

    <description>
        AI Agent 模块
    </description>




    <dependencies>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!--
            MyBatis-Plus 3.5.9+ 把 JSqlParser 支持拆成了独立模块。
            分页拦截器 PaginationInnerInterceptor 依赖它，不引会报 NoClassDefFoundError。
            本地仓库只有 3.5.16，与 3.5.17 core 兼容，先固定该版本。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.16</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

        <!-- 参数校验（@Valid / @NotBlank / @Size，用于 ChatRequest） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <!-- 租户上下文（TenantContextHolder，供 ToolAuditService 记录 tenantId） -->
        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-tenant</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <!--
            知识库模块：Agent 依赖 Knowledge（PolicyTools → refundPolicyRAG）。
            依赖方向必须单向：agent → knowledge。
            不允许 knowledge → agent（否则形成循环依赖）。
        -->
        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-knowledge</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- Spring AI Tool 注解与 ToolCallbackProvider（版本由根 pom 的 BOM 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- Spring AI OpenAI 兼容客户端（ChatClient + OpenAiChatModel，DeepSeek 走 OpenAI 兼容接口） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>













</project>