<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.omnimerchant</groupId>
        <artifactId>omni-merchant</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>omni-merchant-bootstrap</artifactId>

    <packaging>jar</packaging>

    <description>
        Spring Boot 启动模块
    </description>


    <dependencies>

        <!-- ============================== -->
        <!-- 业务模块 -->
        <!-- ============================== -->

        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-agent</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-channel</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-message</artifactId>
            <version>${project.version}</version>
        </dependency>


        <!-- ============================== -->
        <!-- 最基础 Spring Boot -->
        <!-- ============================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>


        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.omnimerchant</groupId>
            <artifactId>omni-merchant-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>


        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>







    </dependencies>


    <build>

        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <mainClass>
                        com.omnimerchant.OmniMerchantApplication
                    </mainClass>
                </configuration>

            </plugin>

        </plugins>

    </build>

</project>